    "def huellas(ruta):\n",
    "    im = Image.open(ruta); im.draft(\"RGB\", (im.width // 2, im.height // 2))     # misma reducción que en la Fase 1\n",
    "    return {\"archivo\": ruta.name, \"sha256\": hashlib.sha256(ruta.read_bytes()).hexdigest(), \"phash\": str(imagehash.phash(im.convert(\"RGB\")))}\n",
    "\n",
    "fotos = sorted((RAW / \"Photos\").glob(\"*.jpg\"))\n",
    "hue = pd.DataFrame([huellas(p) for p in fotos])\n",
    "bits = np.array([np.unpackbits(np.frombuffer(bytes.fromhex(h), dtype=np.uint8)) for h in hue[\"phash\"]], dtype=np.int32)\n",
    "dist = bits @ (1 - bits).T + (1 - bits) @ bits.T            # distancia de Hamming entre todos los pares\n",
    "resumen_dup = []\n",
    "for umbral in (0, 2, 5, 8):\n",
    "    i, j = np.where(np.triu(dist <= umbral, k=1))\n",
    "    exactos = int(sum(hue[\"sha256\"].iat[a] == hue[\"sha256\"].iat[b] for a, b in zip(i, j)))\n",
    "    resumen_dup.append({\"distancia_pHash_max\": umbral, \"pares\": len(i), \"pares_byte_a_byte\": exactos, \"pares_solo_visuales\": len(i) - exactos})\n",
    "resumen_dup = pd.DataFrame(resumen_dup)\n",
    "grupos_sha = int((hue.groupby(\"sha256\").size() > 1).sum())\n",
    "R2[\"duplicados\"] = {\"grupos_sha256\": grupos_sha, \"por_distancia_phash\": resumen_dup.to_dict(orient=\"records\")}\n",
    "print(f\"Grupos de copias exactas (SHA-256): {grupos_sha}\")\n",
    "ver_tabla(resumen_dup)"
   ]
  },
